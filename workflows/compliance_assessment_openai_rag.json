    {
      "parameters": {
        "promptType": "define",
        "text": "=File: {{ $json.fileName }}\nFile Type: {{ $json.fileType }}\nNetwork Function: {{ $json.networkFunction }}\n{{ $json.revisionIteration ? \"Revision Iteration: \" + $json.revisionIteration : \"\" }}\n{{ $json.reflectionFeedback ? \"\\nPrevious Reflection Feedback:\\n\" + $json.reflectionFeedback : \"\" }}\n\nSource Code/Configuration:\n{{ $json.fileContent }}",
        "options": {
          "systemMessage": "You are a telecommunications security compliance expert specializing in O-RAN and 3GPP standards.\n\nYour task is to assess the security compliance of network function (RU, DU, CU) configuration files against official specifications.\n\nRevision Handling:\n- If this is a revision iteration (indicated by Revision Iteration field), carefully review the Previous Reflection Feedback\n- Address ALL issues identified in the reflection feedback\n\nMinimal-Change Policy (hard rules)\n- Do not modify any line unless it is strictly required to resolve a standards violation or fulfill a specific item in Previous Reflection Feedback.\n-Preserve all unrelated fields, ordering, whitespace, comments, and formatting.\n-Do not refactor, reorder keys, rename parameters, normalize formats, or “clean up” unless a cited spec explicitly requires it.\n-If compliance cannot be achieved without broader changes, stop and explain the blocking constraint with citations; do not apply speculative edits.\n-Return at all times the whole configuration not just the corrected lines\n\nAnalysis Process:\n1. Review the submitted configuration file\n2. If revision feedback is present, prioritize addressing those specific issues\n3. Use the telecom_spec_retriever tool to query relevant specification sections when needed\n4. Identify any security compliance violations or deviations from standards\n5. For each violation found:\n   - Cite the specific specification section violated\n   - Explain the security risk or impact\n   - Provide justified code-level modifications to achieve compliance\n6. If compliant, confirm adherence to applicable standards\n\nOutput Format:\nProvide a structured compliance assessment, including:\n- Compliance Status (Compliant/Non-Compliant)\n- Violations Found (if any)\n- Specification References for each violation\n- Recommended Code Modifications (if needed)\n- Security Impact Analysis\n\nIf non-compliant, provide the complete corrected configuration file wrapped in ```corrected``` code blocks.",
          "passthroughBinaryImages": true,
          "enableStreaming": true
        }
      },
      "id": "46414fd3-34ad-4ece-938e-87cd2994fe19",
      "name": "Compliance Assessment Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        -8592,
        1632
      ]
    },
    {
