    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c6f7c1ae-0d2f-42e3-9f69-e7fbefe027d5",
              "name": "Assessment",
              "value": "={{ (\n  ($json.output || '')\n    .replace(/```corrected[\\t ]*\\r?\\n[\\s\\S]*?\\r?\\n```/gi,'')                             /* remove fenced corrected block */\n    .replace(/^\\s*Corrected Configuration(?: File)?[^:\\n]*:\\s*(?:\\r?\\n)?[\\s\\S]*?(?=(?:\\r?\\n)?Summary:|$)/i,'')  /* remove narrative under the heading */\n    .replace(/Summary:\\s*([\\s\\S]*)$/i,'')                                                /* (optional) drop Summary if you only want assessment */\n    .replace(/^\\s*-{3,}\\s*$/gmi,'')                                                      /* clean --- separators */\n    .replace(/^\\s*Corrected Configuration(?: File)?[^:\\n]*:\\s*$/gmi,'')                  /* clean stray heading line if any */\n    .trim()\n) }}\n",
              "type": "string"
            },
            {
              "id": "89f05473-42a7-4964-9296-239c92fbcfc9",
              "name": "correctedConfig",
              "value": "={{ $json.output.match(/```corrected\\n([\\s\\S]*?)\\n```/)?.[1] || '' }}",
              "type": "string"
            },
            {
              "id": "3a65ef3a-3530-4d8d-b1d9-847a4fb1f7cc",
              "name": "Summary",
              "value": "={{ (((($json.output || '').replace(/```corrected[\\t ]*\\r?\\n[\\s\\S]*?\\r?\\n```/gi,'')) .match(/Summary:\\s*([\\s\\S]*)$/i) || [])[1] || '').trim() }}\n",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "055b342e-590d-4700-a20a-e07c7a803b65",
      "name": "Extract Corrected Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -8272,
        1632
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Filename: {{ $('Pre-process Files').item.json.File[0].filename }}\nFile Type: {{ $('Pre-process Files').item.json['File Type'] }}\nOriginal Configuration:\n{{ $('Pre-process Files').item.json.fileContent }}\n\nCorrected Configuration:\n{{ $json.correctedConfig }}\n\nOriginal Assessment:\n{{ $json.Assessment }}\n\nSummary:\n{{ $json.Summary }}\n\n{{ $json.executionResult ? \"Code Execution Result: \" + $json.executionResult + \"\\nErrors: \" + JSON.stringify($json.errors) : \"\" }}",
        "options": {
          "systemMessage": "You are a critical reviewer specializing in telecommunications security compliance.\n\nYour task is to review the corrected configuration provided by the compliance agent and determine if it truly resolves all identified violations.\n\nAnalysis Process:\n1. Compare the original and corrected configurations\n2. Verify each violation mentioned in the original assessment is addressed\n3. Use the telecom_spec_retriever tool to double-check compliance requirements\n5. Identify any remaining issues or new problems introduced\n\nOutput Format:\nProvide a JSON response with:\n{\n  \"needsRevision\": true/false,\n  \"reasoning\": \"Detailed explanation of your decision\",\n  \"remainingIssues\": [\"List of any remaining problems\"]\n}",
          "passthroughBinaryImages": true,
          "enableStreaming": true
        }
      },
