    {
      "parameters": {
        "jsCode": "// Get all incoming items\nconst items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  // --- 1️⃣ Read the binary buffer for property \"File\"\n  const buffer = await this.helpers.getBinaryDataBuffer(i, 'File');\n\n  // --- 2️⃣ Convert the buffer to text (UTF-8 for text/plain)\n  const fileContent = buffer.toString('utf8');\n\n  // --- 3️⃣ Add the content to JSON output for inspection / next nodes\n  items[i].json.fileContent = fileContent;\n\n  // --- Optional: log it to the console for debugging (appears in n8n logs)\n  console.log(`File content for item ${i}:`, fileContent);\n}\n\n// Return modified items\nreturn items;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
